# GEO Monitor — Environment Variables
# Copy this file to .env.local and fill in the values

# ──────────────────────────────────────────────
# REQUIRED
# ──────────────────────────────────────────────

# Neon Postgres connection string
# Get it from: https://neon.tech → Project → Connection Details
DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# OpenAI API key — provider primario per site-analyze, generate-queries, extract-competitors
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────
# OPTIONAL — sblocca provider aggiuntivi nel UI
# ──────────────────────────────────────────────

# Anthropic API key — sblocca Claude nel UI
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API key — sblocca Gemini nel UI
GEMINI_API_KEY=AI...
